<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>
    <groupId>com.fuoverflow</groupId>
    <artifactId>fuoverflow-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fuoverflow-backend</name>
    <description>FuOverflow-like backend monolith</description>
    <modules>
        <module>app</module>
        <module>common</module>
        <module>auth</module>
        <module>user</module>
        <module>forum</module>
        <module>thread</module>
        <module>post</module>
        <module>reaction</module>
        <module>notification</module>
        <module>award</module>
        <module>coursera</module>
        <module>source</module>
        <module>membership</module>
        <module>course</module>
        <module>material</module>
        <module>payment</module>
        <module>deposit</module>
        <module>search</module>
        <module>moderation</module>
        <module>admin</module>
        <module>worker</module>
        <module>broadcast</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
