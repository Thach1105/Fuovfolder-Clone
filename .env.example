# FuOverflow production env (Docker Compose on server)
# Copy: cp .env.example /opt/fuoverflow/.env && nano /opt/fuoverflow/.env
# On server: dos2unix /opt/fuoverflow/.env
# Quote values that contain spaces, @, or !
#
# Deploy model:
# - Push to main -> GitHub Actions (self-hosted) builds Docker images and runs deploy/docker-compose.yml
# - /opt/fuoverflow/.env is the only file required under /opt/fuoverflow for CI (plus data/ dirs)
# - Do NOT run docker compose from /opt/fuoverflow unless it is a full git clone with source code

SPRING_PROFILES_ACTIVE=prod

# --- Published ports (host:container) ---
BACKEND_PUBLISH_PORT=18080
FRONTEND_PUBLISH_PORT=19080
POSTGRES_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6379
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001

# --- PostgreSQL (postgres service in deploy/docker-compose.yml) ---
POSTGRES_DB=fuoverflow
DB_USERNAME=fuoverflow-admin
DB_PASSWORD='CHANGE_ME_db_password'
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=5
# Overridden inside backend container to jdbc:postgresql://postgres:5432/fuoverflow
DB_URL=jdbc:postgresql://postgres:5432/fuoverflow

# --- Redis (redis service) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Object storage (minio service) ---
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=fuoverflow-media
STORAGE_S3_ACCESS_KEY=fuoverflow
STORAGE_S3_SECRET_KEY='CHANGE_ME_minio_secret'
# Public URL for browser (no trailing slash)
STORAGE_S3_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:9000
STORAGE_S3_PATH_STYLE=true

FUO_UPLOADS_PATH=/opt/fuoverflow/data/uploads
FUO_LOGS_PATH=/opt/fuoverflow/data/logs
FUO_TEMP_PATH=/opt/fuoverflow/data/tmp

# --- CORS (frontend origin as seen by the browser) ---
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:19080
CORS_ALLOW_CREDENTIALS=true

# --- Auth / JWT cookies ---
AUTH_ISSUER=fuoverflow
AUTH_AUDIENCE=fuoverflow-api
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_REFRESH_TOKEN_PEPPER='CHANGE_ME_refresh_token_pepper_min_32_chars'
AUTH_JWT_KEY_ID=prod-key-1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_ACCESS_COOKIE_NAME=fuoverflow_at
AUTH_REFRESH_COOKIE_NAME=fuoverflow_rt

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD='your gmail app password with spaces'
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=5000

AUTH_EMAIL_VERIFICATION_ENABLED=true
AUTH_EMAIL_VERIFICATION_URL_BASE=http://YOUR_SERVER_IP:19080/verify-email
AUTH_EMAIL_VERIFICATION_SUBJECT='Verify your FuOverflow email'

AUTH_PASSWORD_RESET_ENABLED=true
AUTH_PASSWORD_RESET_URL_BASE=http://YOUR_SERVER_IP:19080/reset-password
AUTH_PASSWORD_RESET_SUBJECT='Reset your FuOverflow password'
AUTH_PASSWORD_RESET_TOKEN_TTL=1h

# --- Admin seed (first deploy only; set false after admin exists) ---
FUO_ADMIN_SEED_ENABLED=true
FUO_ADMIN_EMAIL=admin@yourdomain.com
FUO_ADMIN_USERNAME=fuoverflow-admin
FUO_ADMIN_PASSWORD='CHANGE_ME_admin_password'
FUO_ADMIN_DISPLAY_NAME='FuOverflow Administrator'

COURSERA_CREDENTIALS_ENCRYPTION_KEY='CHANGE_ME_coursera_key_at_least_32_chars!!'

SOURCE_REFUND_ENABLED=true
SOURCE_DEFAULT_PAGE_SIZE=24
SOURCE_EXPIRY_SCAN_INTERVAL_MS=60000

# --- Frontend build args (embedded at docker build time) ---
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:18080
NEXT_PUBLIC_STORAGE_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:9000/fuoverflow-media

# Optional: path to env file for docker compose (default /opt/fuoverflow/.env)
# ENV_FILE=/opt/fuoverflow/.env
